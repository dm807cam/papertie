{
  "name": "@papertie/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Papertie, the desktop app: the local server in Electron's main process.",
  "license": "GPL-3.0-or-later",
  "author": "The Papertie authors",
  "homepage": "https://github.com/dm807cam/papertie",
  "repository": {
    "type": "git",
    "url": "https://github.com/dm807cam/papertie.git"
  },
  "bugs": {
    "url": "https://github.com/dm807cam/papertie/issues"
  },
  "productName": "Papertie",
  "desktopName": "papertie.desktop",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/ensure-electron.mjs && node scripts/build.mjs && electron .",
    "dist": "electron-builder --config electron-builder.yml --publish never",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@papertie/core": "workspace:*",
    "@types/node": "22.20.5",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  }
}
