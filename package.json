{
  "name": "papertie",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:timing": "pnpm -r --if-present test:timing",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:server": "pnpm --filter @papertie/server test:server",
    "test:crash": "pnpm --filter @papertie/server test:crash",
    "dev:web": "pnpm --filter @papertie/web dev",
    "dev:desktop": "pnpm --filter @papertie/web build && pnpm --filter @papertie/desktop start",
    "e2e:desktop": "pnpm --filter @papertie/web build && pnpm --filter @papertie/desktop build && node apps/desktop/scripts/ensure-electron.mjs && playwright test -c e2e/playwright.config.ts --project=desktop",
    "e2e:app": "pnpm --filter @papertie/web build && pnpm --filter @papertie/desktop build && node apps/desktop/scripts/ensure-electron.mjs && playwright test -c e2e/playwright.config.ts --project=app",
    "bench": "playwright test -c e2e/playwright.config.ts --project=bench",
    "bench:desktop": "playwright test -c e2e/playwright.config.ts --project=desktop-bench",
    "bench:report": "pnpm --filter @papertie/tools exec tsx src/benchReport.ts",
    "budget": "pnpm --filter @papertie/tools exec tsx src/bundleBudget.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "1.64.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
